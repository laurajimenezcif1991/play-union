---
import { nav, site } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/images/logo.png" width="80" height="58" alt="Play Union logo" />
      <span class="brand-text">
        <span class="brand-name" aria-label="Play Union">
          <span>P</span><span>l</span><span>a</span><span>y</span><span class="union">Union</span>
        </span>
        <span class="brand-tag">{site.tagline}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="nav-toggle">
      Menu
    </button>

    <div class="nav-panel" id="site-nav">
      <nav aria-label="Primary">
        <ul class="nav-list">
          {
            nav.map((item) => (
              <li class={'children' in item && item.children ? 'has-submenu' : undefined}>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {'children' in item && item.children ? (
                  <ul class="submenu">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="btn btn-primary header-cta" href="/visit/">Plan Your Visit</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

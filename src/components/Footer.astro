---
import { footerNav, site } from '../data/site';
import { asset } from '../lib/asset';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h2 style="color:white;font-size:1.35rem;">Play Union</h2>
      <p>{site.tagline}</p>
      <p>
        {site.address.line1}<br />
        {site.address.city}, {site.address.state} {site.address.zip}
      </p>
      <p>
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div>
      <h3 style="color:white;">Explore</h3>
      <p><a href={asset('visit/')}>Visit</a></p>
      <p><a href={asset('passes/')}>Passes</a></p>
      <p><a href={asset('classes-events/')}>Events</a></p>
      <p><a href={asset('private-events/birthday-parties/')}>Parties</a></p>
      <p><a href={asset('contact/')}>Contact</a></p>
    </div>
    <div>
      <h3 style="color:white;">More info</h3>
      {
        footerNav.map((item) => (
          <p>
            <a href={asset(item.href)}>{item.label}</a>
          </p>
        ))
      }
      <p>
        <a href={site.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
      </p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>© {new Date().getFullYear()} Play Union</p>
  </div>
</footer>

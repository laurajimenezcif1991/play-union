---
import PageHero from './PageHero.astro';
import { asset } from '../lib/asset';
---

<PageHero
  title="The Science Hidden in Pretend Play"
  lede="What if pretend play is teaching more than we can see? At Play Union, every moment of pretend play can support learning, imagination, and social growth."
  carousel
  ctas={[
    { href: 'visit/', label: 'Plan Your Visit', variant: 'primary' },
    { href: 'passes/', label: 'Buy a Pass', variant: 'outline' },
  ]}
  sliderId="hero-slider"
  floats={['tower']}
  slides={[
    {
      src: asset('images/hero/slide-4.jpg'),
      alt: 'Children dancing during a singalong at Play Union',
    },
    {
      src: asset('images/hero/slide-1.jpg'),
      alt: 'Child focused on a wooden puzzle at Play Union',
    },
    {
      src: asset('images/hero/slide-2.jpg'),
      alt: 'Caregiver and toddler playing with a dress-up puzzle',
    },
    {
      src: asset('images/hero/slide-3.jpg'),
      alt: 'Colorful toys and play structures inside Play Union',
    },
  ]}
/>

---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="product-card">
  <h3>{product.name}</h3>
  <p class="price">{product.priceLabel}</p>
  {product.note ? <p class="note">{product.note}</p> : null}
  {
    product.benefits?.length ? (
      <ul>
        {product.benefits.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    ) : null
  }
  <button
    type="button"
    class="btn btn-secondary js-add-demo"
    data-id={product.id}
    data-name={product.name}
    data-price={product.price}
    data-url={product.purchaseUrl ?? ''}
  >
    Add to cart (demo)
  </button>
</article>

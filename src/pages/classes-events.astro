---
import { asset } from '../lib/asset';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsCalendar from '../components/EventsCalendar.astro';
import { featuredVideo, visibleEvents } from '../data/events';

const list = visibleEvents();
---

<BaseLayout
  title="Events and classes"
  description="Find toddler activities, singalongs, and classes at Play Union in Somerville. Browse the monthly calendar schedule."
  currentPath="/classes-events/"
>
  <section class="section section-tight">
    <div class="wrap home-hero-inner events-hero">
      <div class="hero-copy">
        <h1>Events and classes</h1>
        <p class="lede">Classes and special events at Play Union.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={asset("/visit/")}>Plan Your Visit</a>
          <a class="btn btn-outline" href={asset("/contact/?reason=class-or-event")}>Contact Us</a>
        </div>
      </div>

      <div class="hero-stage">
        {
          featuredVideo ? (
            <figure class="hero-frame events-hero-video">
              {featuredVideo.type === 'file' ? (
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  controls
                  poster={featuredVideo.poster ? asset(featuredVideo.poster) : undefined}
                  src={asset(featuredVideo.src)}
                  aria-label={featuredVideo.title}
                >
                  Your browser does not support video playback.
                </video>
              ) : (
                <iframe
                  src={`${featuredVideo.src}${featuredVideo.src.includes('?') ? '&' : '?'}autoplay=1&mute=1`}
                  title={featuredVideo.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              )}
            </figure>
          ) : (
            <div class="info-panel event-video-help">
              <h2>Add a video</h2>
              <p class="note">
                Set <code>featuredVideo</code> in <code>src/data/events.ts</code> to show a clip here.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <EventsCalendar />
    </div>

    {
      list.length ? (
        <div class="wrap event-list" style="margin-top: 2rem;">
          <h2 class="events-detail-heading">Program notes</h2>
          {list.map((event) => (
            <article class="event-card">
              <div class="meta">
                {event.status === 'needs-review' ? (
                  <span class="flag">OWNER CONFIRMATION NEEDED</span>
                ) : (
                  <span class="flag" style="background:#e8f7e9;border-color:#8fd196;color:#1f6b2a;">
                    Confirmed
                  </span>
                )}
                {event.recurringNote ? <span>{event.recurringNote}</span> : null}
              </div>
              <h3>{event.title}</h3>
              <div class="meta">
                <span>
                  <strong>Time:</strong> {event.time}
                </span>
                <span>
                  <strong>Instructor:</strong> {event.instructor}
                </span>
                <span>
                  <strong>Ages:</strong> {event.ageRange}
                </span>
              </div>
              <p>
                <strong>Price / pass:</strong> {event.priceOrPass}
              </p>
              {event.notes ? <p class="note">{event.notes}</p> : null}
              <div class="cta-row">
                {event.registrationUrl ? (
                  <a
                    class="btn btn-secondary"
                    href={event.registrationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Register
                  </a>
                ) : (
                  <a class="btn btn-outline" href={asset("/contact/?reason=class-or-event")}>
                    Ask about this event
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : null
    }
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={site.name}
  description="Play Union is a welcoming indoor pretend-play and craft space in Somerville for young children and caregivers. Play • Learn • Grow."
  currentPath="/"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="note" style="font-weight:800;color:var(--pink-deep);margin-bottom:0.35rem;">
          Indoor play space in Somerville
        </p>
        <h1>Play Union</h1>
        <p class="lede">
          A welcoming place where young children explore, imagine, create, and play — and families
          connect. {site.tagline}
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/visit/">Plan Your Visit</a>
          <a class="btn btn-outline" href="/passes/">Buy a Pass</a>
        </div>
      </div>
      <div class="hero-media">
        <img
          src="/images/space-recent.png"
          alt="Children and caregivers playing together inside Play Union in Somerville"
          width="1536"
          height="1024"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>What would you like to do?</h2>
        <p class="lede">
          Drop in for open play, compare passes, find toddler activities and classes, or plan a
          children’s birthday party in Somerville.
        </p>
      </div>
      <div class="card-grid">
        <article class="action-card">
          <div class="accent accent-pink"></div>
          <h3>Open Play</h3>
          <p>Pretend play, crafts, and community time for young children and caregivers.</p>
          <a class="btn btn-primary" href="/visit/">Plan Your Visit</a>
        </article>
        <article class="action-card">
          <div class="accent accent-green"></div>
          <h3>Passes & Memberships</h3>
          <p>Compare day passes, multi-day punch cards, and memberships.</p>
          <a class="btn btn-secondary" href="/passes/">Buy a Pass</a>
        </article>
        <article class="action-card">
          <div class="accent accent-yellow"></div>
          <h3>Classes & Events</h3>
          <p>See the editable schedule for singalongs, classes, and special events.</p>
          <a class="btn btn-outline" href="/classes-events/">View Classes & Events</a>
        </article>
        <article class="action-card">
          <div class="accent accent-blue"></div>
          <h3>Private Events</h3>
          <p>Kids’ birthday parties, other rentals, and community partnerships.</p>
          <a class="btn btn-blue" href="/private-events/birthday-parties/">Ask About a Party</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split-2">
      <div class="info-panel">
        <h2>Location & hours</h2>
        <p>
          <strong>{site.address.full}</strong>
        </p>
        <table class="hours-table">
          <tbody>
            {
              site.hours.map((row) => (
                <tr>
                  <th scope="row">{row.days}</th>
                  <td>{row.time}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">{site.finalEntryNote}</p>
        <div class="cta-row">
          <a class="btn btn-outline" href="/visit/">Full visit details</a>
          <a class="btn btn-primary" href="/contact/">Contact Us</a>
        </div>
      </div>
      <div class="hero-media">
        <img
          src="/images/space-play.jpg"
          alt="Play areas and toys inside Play Union’s indoor play space"
          width="1200"
          height="1600"
        />
      </div>
    </div>
  </section>
</BaseLayout>

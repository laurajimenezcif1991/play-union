---
import { asset } from '../lib/asset';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const services = [
  {
    title: 'Passes & Memberships',
    body: 'Compare day passes, multi-day punch cards, and memberships.',
    href: '/passes/',
    cta: 'Buy a Pass',
    variant: 'secondary',
    accent: 'accent-green',
    icon: 'ticket' as const,
  },
  {
    title: 'Events and classes',
    body: 'See the monthly calendar for singalongs, classes, and special events.',
    href: '/classes-events/',
    cta: 'View calendar',
    variant: 'outline',
    accent: 'accent-yellow',
    icon: 'calendar-event' as const,
  },
  {
    title: 'Private Events',
    body: 'Kids’ birthday parties, other rentals, and community partnerships.',
    href: '/private-events/birthday-parties/',
    cta: 'Ask About a Party',
    variant: 'blue',
    accent: 'accent-blue',
    icon: 'cake' as const,
  },
];
---

<BaseLayout
  title={site.name}
  description="Play Union is a welcoming indoor pretend-play and craft space in Somerville for young children and caregivers. Play • Learn • Grow."
  currentPath="/"
>
  <HomeHero />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>What would you like to do?</h2>
        <p class="lede">
          Drop in for open play, compare passes, find toddler activities and classes, or plan a
          children’s birthday party in Somerville.
        </p>
      </div>
      <div class="card-grid">
        {
          services.map((service) => (
            <article class="action-card">
              <div class={`action-icon ${service.accent}`} aria-hidden="true">
                <Icon name={service.icon} size={26} />
              </div>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              <a class={`btn btn-${service.variant}`} href={asset(service.href)}>
                {service.cta}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split-2">
      <div class="info-panel">
        <h2>
          <span class="inline-icon" aria-hidden="true"><Icon name="map-pin" size={22} /></span>
          Location &amp; hours
        </h2>
        <p>
          <strong>{site.address.full}</strong>
        </p>
        <table class="hours-table">
          <tbody>
            {
              site.hours.map((row) => (
                <tr>
                  <th scope="row">{row.days}</th>
                  <td>{row.time}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">{site.finalEntryNote}</p>
        <div class="cta-row">
          <a class="btn btn-outline" href={asset("/visit/")}>Full visit details</a>
          <a class="btn btn-primary" href={asset("/contact/")}>Contact Us</a>
        </div>
      </div>
      <div class="hero-media">
        <img
          src={asset("/images/space-play.jpg")}
          alt="Play areas and toys inside Play Union’s indoor play space"
          width="1200"
          height="1600"
        />
      </div>
    </div>
  </section>
</BaseLayout>

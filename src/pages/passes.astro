---
import { asset } from '../lib/asset';
import BaseLayout from '../layouts/BaseLayout.astro';
import PassChooser from '../components/PassChooser.astro';
import PricingCards from '../components/PricingCards.astro';
---

<BaseLayout
  title="Passes & Memberships"
  description="Play Union day passes, punch cards, and memberships — clear pricing for families in Somerville."
  currentPath="/passes/"
>
  <section class="section section-tight">
    <div class="wrap">
      <PassChooser />
    </div>
  </section>

  <PricingCards />
</BaseLayout>
